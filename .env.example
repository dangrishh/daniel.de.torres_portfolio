# Resend (https://resend.com) API key used by app/api/contact/route.ts to send
# the contact form email. Create a free account, verify a sending domain (or
# use their onboarding@resend.dev sender for testing), then paste the key below.
RESEND_API_KEY=

# The address that receives contact form submissions.
CONTACT_TO_EMAIL=danieldetorres.info@gmail.com

# The "from" address Resend sends as. Must be on a domain you verified in
# Resend, or onboarding@resend.dev while testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev
